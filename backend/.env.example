# Copy to backend/.env and fill in. Never commit backend/.env.

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=
# Any random string of 32+ characters: openssl rand -hex 32
SESSION_SECRET=
# Wallet addresses (base58, comma separated) allowed to sign in and trade
OPERATOR_WALLETS=

# Backpack API key pair (ED25519, base64), created under Settings > API Keys
BACKPACK_API_KEY=
BACKPACK_PRIVATE_KEY=

# Trading switches and limits (PRD sections 45 and 46)
TRADING_ENABLED=
DEMO_MODE=
MAX_TOTAL_NOTIONAL_USD=
MAX_POSITION_NOTIONAL_USD=
MAX_APPLICATION_LEVERAGE=
ALLOWED_SYMBOLS=
MAX_SLIPPAGE_BPS=
MARGIN_BUFFER=

# Risk bands on Backpack's maintenance margin rate (PRD section 26)
MMR_WARNING=
MMR_RISK=
MMR_REDUCE=
MMR_EMERGENCY=

# Convergence engine (PRD sections 31 and 32)
CONVERGENCE_BPS=
CONVERGENCE_COUNT=
REOPEN_COOLDOWN_SEC=
DEMO_COOLDOWN_SEC=
MAX_CONVERGENCE_WAIT_SEC=
ORACLE_TOLERANCE_BPS=

# Chainlink CRE oracle. Mode is "simulation" until deploy access is granted, then "don".
CRE_REPORT_MODE=
# Shared with the workflow (cre/.env). openssl rand -hex 24
CRE_INGEST_TOKEN=
CRE_PROJECT_DIR=
CRE_WORKFLOW_NAME=
CRE_TARGET=
CRE_SIM_INTERVAL_SEC=
CRE_WORKFLOW_ID=
ETH_MAINNET_RPC_URL=

# Solana mainnet Memo anchoring. Leave the key empty to turn anchoring off.
SOLANA_RPC_URL=
SOLANA_PRIVATE_KEY=
