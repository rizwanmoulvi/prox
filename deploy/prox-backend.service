# systemd unit for the backend. Install: sudo cp deploy/prox-backend.service /etc/systemd/system/
# then: sudo systemctl daemon-reload && sudo systemctl enable --now prox-backend
[Unit]
Description=ProX backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/prox/backend
ExecStart=/home/ubuntu/prox/backend/node_modules/.bin/tsx src/server.ts
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
